    "indiscernibility_pass": false,

    "reduct": true,
    "rules": true,
    "indiscernibility": false,
    "coverage": true,

    "plots": true
  },

  "output": {
    "dir": "./Auswertung/results/auswertung_results_students_ohne_cutoffs",
    "prefix": "",
    "save_intermediate_disc": false,
    "save_reducts": true,
    "save_rules": true,
    "save_indiscernibility": false,
    "save_coverage": true,
    "save_plots": true,
    "overwrite": true
