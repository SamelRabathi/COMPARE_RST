{
  "mode": "single_dataset",

  "data": {
    "biased_csv": "./Student_Performance_Behavior_Dataset/Students_Grading_Dataset_Biased.csv",
    "unbiased_csv": "./Student_Performance_Behavior_Dataset/Students_Performance_Dataset.csv",

    "file": "./Crimes/LA_Crimes_2025.parquet",
    "file_type": "parquet",

    "categorical_definite": [
      "AREA",
      "AREA NAME",
      "Part 1-2",
      "Vict Sex",
      "Vict Descent",
      "Status",
      "Status Desc",
      "occ_year",
      "occ_month",
      "occ_date",
      "occ_day"
    ],

    "categorical_optional": [
      "Crm Cd",
      "Crm Cd Desc",
      "Weapon Used Cd",
      "Weapon Desc",
      "Premis Cd",
      "Premis Desc"
    ]
  },

  "decision_attribute": "Weapon Used Cd",
  "bins": 4,
  "cutoffs": {},

  "create_pass": true,
  "pass_grades": [],

  "exclude_attrs": ["DR_NO"],

  "operations": {
    "reduct_grade": false,
    "rules_grade": false,
    "coverage_grade": false,

    "reduct_pass": false,
    "rules_pass": false,
    "coverage_pass": false,
    "indiscernibility_pass": false,

    "reduct": true,
    "rules": true,
    "indiscernibility": false,
    "coverage": true,

    "plots": true
  },

  "output": {
    "dir": "./auswertung_results_crimes",
    "prefix": "",
    "save_intermediate_disc": false,
    "save_reducts": true,
    "save_rules": true,
    "save_indiscernibility": false,
    "save_coverage": true,
    "save_plots": true,
    "overwrite": true
  }
}
